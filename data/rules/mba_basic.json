{
  "name": "mba_basic",
  "description": "Basic MBA simplification rules",
  "rules": [
    {
      "id": "mba_xor_1",
      "pattern": "(x | y) - (x & y)",
      "replacement": "x ^ y",
      "commutative": true,
      "description": "Mixed boolean-arithmetic XOR identity"
    },
    {
      "id": "mba_xor_2",
      "pattern": "(x & ~y) | (~x & y)",
      "replacement": "x ^ y",
      "commutative": true,
      "description": "XOR via complement masking"
    },
    {
      "id": "mba_add_1",
      "pattern": "(x | y) + (x & y)",
      "replacement": "x + y",
      "commutative": true,
      "description": "Addition via OR and AND"
    },
    {
      "id": "mba_add_2",
      "pattern": "(x ^ y) + 2 * (x & y)",
      "replacement": "x + y",
      "commutative": true,
      "description": "Addition via XOR and AND"
    },
    {
      "id": "mba_neg_1",
      "pattern": "~x + 1",
      "replacement": "-x",
      "commutative": false,
      "description": "Two's complement negation"
    },
    {
      "id": "mba_sub_1",
      "pattern": "x + ~y + 1",
      "replacement": "x - y",
      "commutative": false,
      "description": "Subtraction via complement addition"
    },
    {
      "id": "mba_zero_1",
      "pattern": "x ^ x",
      "replacement": "0",
      "commutative": false,
      "description": "Self-XOR is zero"
    },
    {
      "id": "mba_identity_1",
      "pattern": "x | 0",
      "replacement": "x",
      "commutative": true,
      "description": "OR with zero identity"
    },
    {
      "id": "mba_identity_2",
      "pattern": "x & ~0",
      "replacement": "x",
      "commutative": false,
      "description": "AND with all-ones identity"
    },
    {
      "id": "mba_absorb_1",
      "pattern": "x & 0",
      "replacement": "0",
      "commutative": true,
      "description": "AND with zero absorbs"
    }
  ]
}
