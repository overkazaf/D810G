{
  "name": "mba_ollvm",
  "description": "OLLVM-specific instruction substitution patterns",
  "rules": [
    {"id": "ollvm_add_1", "pattern": "x - (~y)", "replacement": "x + y + 1", "commutative": false, "description": "OLLVM add substitution variant 1"},
    {"id": "ollvm_add_3", "pattern": "~(~x + ~y)", "replacement": "x + y + 1", "commutative": true, "description": "OLLVM add variant with double complement"},
    {"id": "ollvm_sub_2", "pattern": "~(~x - y)", "replacement": "x + y", "commutative": false, "description": "OLLVM sub variant with complement"},
    {"id": "ollvm_and_2", "pattern": "(x ^ ~y) & x", "replacement": "x & y", "commutative": false, "description": "OLLVM AND variant"},
    {"id": "ollvm_xor_1", "pattern": "(~x & y) | (x & ~y)", "replacement": "x ^ y", "commutative": true, "description": "OLLVM XOR via masked complements"},
    {"id": "ollvm_xor_2", "pattern": "~(~x & ~y) & ~(x & y)", "replacement": "x ^ y", "commutative": true, "description": "OLLVM XOR via double De Morgan"},
    {"id": "ollvm_not_1", "pattern": "~x ^ 0", "replacement": "~x", "commutative": false, "description": "OLLVM redundant XOR with 0"},
    {"id": "ollvm_identity_1", "pattern": "~~x", "replacement": "x", "commutative": false, "description": "Double negation elimination"},
    {"id": "ollvm_mul_1", "pattern": "(x << 3) - x", "replacement": "x * 7", "commutative": false, "description": "OLLVM multiply by 7 via shift-sub"},
    {"id": "ollvm_mul_2", "pattern": "(x << 2) + x", "replacement": "x * 5", "commutative": false, "description": "OLLVM multiply by 5 via shift-add"},
    {"id": "ollvm_add_neg", "pattern": "x - (-y)", "replacement": "x + y", "commutative": false, "description": "OLLVM addNeg: a = b - (-c)"},
    {"id": "ollvm_add_double_neg", "pattern": "-(-x + (-y))", "replacement": "x + y", "commutative": false, "description": "OLLVM addDoubleNeg: a = -(-b + (-c))"},
    {"id": "ollvm_add_double_neg_2", "pattern": "-(-x - y)", "replacement": "x + y", "commutative": false, "description": "OLLVM addDoubleNeg after subNeg folded the inner -(-c)"},
    {"id": "ollvm_add_rand_1", "pattern": "((x + z) + y) - z", "replacement": "x + y", "commutative": false, "description": "OLLVM addRand: r = rand(); a = ((b + r) + c) - r"},
    {"id": "ollvm_add_rand_2", "pattern": "((x - z) + y) + z", "replacement": "x + y", "commutative": false, "description": "OLLVM addRand2: r = rand(); a = ((b - r) + c) + r"},
    {"id": "ollvm_sub_neg", "pattern": "x + (-y)", "replacement": "x - y", "commutative": false, "description": "OLLVM subNeg: a = b + (-c)"},
    {"id": "ollvm_sub_rand_1", "pattern": "((x + z) - y) - z", "replacement": "x - y", "commutative": false, "description": "OLLVM subRand: r = rand(); a = ((b + r) - c) - r"},
    {"id": "ollvm_sub_rand_2", "pattern": "((x - z) - y) + z", "replacement": "x - y", "commutative": false, "description": "OLLVM subRand2: r = rand(); a = ((b - r) - c) + r"},
    {"id": "ollvm_xor_rand", "pattern": "(x ^ z) ^ (y ^ z)", "replacement": "x ^ y", "commutative": false, "description": "OLLVM xorSubstitutionRand / orSubstitutionRand core: random mask cancels"}
  ]
}
